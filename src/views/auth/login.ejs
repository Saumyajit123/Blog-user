<%- include("../partials/header") %>
    <%- include("../partials/navbar") %>

        <div class="page-wrapper d-flex align-items-center">

            <div class="container py-5">

                <div class="row justify-content-center">

                    <div class="col-lg-5">

                        <div class="dashboard-card">

                            <span class="text-uppercase text-muted small">
                                Welcome back
                            </span>

                            <h1 class="mt-2">
                                Sign in to InkSpace.
                            </h1>

                            <p class="text-muted mb-4">
                                Continue reading and creating stories.
                            </p>

                            <%- include("../partials/flash") %>

                                <form action="/login" method="POST">

                                    <div class="mb-3">
                                        <label class="form-label">
                                            Email
                                        </label>

                                        <input type="email" name="email" class="form-control" required>
                                    </div>


                                    <div class="mb-4">
                                        <label class="form-label">
                                            Password
                                        </label>

                                        <input type="password" name="password" class="form-control" required>
                                    </div>


                                    <button type="submit" class="btn btn-ink w-100">
                                        Sign In
                                    </button>

                                </form>

                                <p class="text-center text-muted mt-4 mb-0">
                                    Don't have an account?
                                    <a href="/register" class="fw-semibold">
                                        Create one
                                    </a>
                                </p>

                        </div>

                    </div>

                </div>

            </div>

        </div>

        <%- include("../partials/footer") %>