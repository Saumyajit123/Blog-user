<%- include("../partials/header") %>
    <%- include("../partials/navbar") %>

        <div class="container py-5">

            <%- include("../partials/flash") %>

                <section class="hero">

                    <div class="row">

                        <div class="col-lg-9">

                            <span class="text-uppercase text-muted">
                                InkSpace Journal
                            </span>

                            <h1 class="mt-3">
                                Ideas worth<br>
                                <em>sharing.</em>
                            </h1>

                            <p class="lead text-muted mt-4" style="max-width:650px">
                                Stories, experiences and ideas from our community
                                of writers.
                            </p>

                        </div>

                    </div>

                </section>


                <div class="d-flex justify-content-between align-items-center mb-4">

                    <h3>
                        Latest stories
                    </h3>

                    <% if (currentUser) { %>

                        <a href="/blogs/create" class="btn btn-ink">
                            Write a story
                        </a>

                        <% } %>

                </div>


                <div class="row g-4">

                    <% blogs.forEach(blog=> { %>

                        <div class="col-md-6 col-lg-4">

                            <article class="blog-card">

                                <% if (blog.image && blog.image.url) { %>

                                    <img src="<%= blog.image.url %>" class="blog-image" alt="<%= blog.title %>">

                                    <% } else { %>

                                        <div class="placeholder-image">
                                            <i class="bi bi-image fs-1"></i>
                                        </div>

                                        <% } %>


                                            <div class="p-4">

                                                <div class="small text-muted mb-2">
                                                    <%= blog.author?.name || "Anonymous" %>
                                                </div>

                                                <h3>
                                                    <%= blog.title %>
                                                </h3>

                                                <p class="text-muted">
                                                    <%= blog.content.substring(0, 130) %>...
                                                </p>

                                                <a href="/blogs/<%= blog._id %>" class="fw-semibold">
                                                    Continue reading →
                                                </a>

                                            </div>

                            </article>

                        </div>

                        <% }) %>

                </div>

        </div>

        <%- include("../partials/footer") %>