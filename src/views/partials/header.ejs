<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">

    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>
        <%= title || "InkSpace" %> | InkSpace
    </title>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">

    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">

    <link rel="preconnect" href="https://fonts.googleapis.com">

    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>

    <link
        href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&family=Playfair+Display:wght@500;600;700&display=swap"
        rel="stylesheet">

    <style>
        :root {
            --ink: #171717;
            --muted: #737373;
            --paper: #f8f7f3;
            --card: #ffffff;
            --line: #e7e5df;
            --accent: #b86b35;
            --accent-dark: #8f4d23;
        }

        * {
            box-sizing: border-box;
        }

        body {
            margin: 0;
            background: var(--paper);
            color: var(--ink);
            font-family: "DM Sans", sans-serif;
        }

        h1,
        h2,
        h3,
        h4,
        h5 {
            font-family: "Playfair Display", serif;
        }

        a {
            text-decoration: none;
            color: inherit;
        }

        .navbar {
            background: rgba(255, 255, 255, .95);
            border-bottom: 1px solid var(--line);
        }

        .brand {
            font-family: "Playfair Display", serif;
            font-size: 1.7rem;
            font-weight: 700;
        }

        .btn-ink {
            background: var(--ink);
            color: white;
            border-radius: 8px;
            padding: 10px 18px;
        }

        .btn-ink:hover {
            background: #333;
            color: white;
        }

        .btn-accent {
            background: var(--accent);
            color: white;
            border: 0;
        }

        .btn-accent:hover {
            background: var(--accent-dark);
            color: white;
        }

        .page-wrapper {
            min-height: calc(100vh - 72px);
        }

        .dashboard-card {
            background: white;
            border: 1px solid var(--line);
            border-radius: 16px;
            padding: 24px;
            height: 100%;
        }

        .stat-number {
            font-size: 2.2rem;
            font-weight: 700;
        }

        .blog-card {
            background: white;
            border: 1px solid var(--line);
            border-radius: 16px;
            overflow: hidden;
            height: 100%;
            transition: .2s ease;
        }

        .blog-card:hover {
            transform: translateY(-4px);
            box-shadow: 0 12px 35px rgba(0, 0, 0, .08);
        }

        .blog-image {
            width: 100%;
            height: 220px;
            object-fit: cover;
        }

        .placeholder-image {
            width: 100%;
            height: 220px;
            background: #ebe8df;
            display: flex;
            align-items: center;
            justify-content: center;
            color: #999;
        }

        .hero {
            padding: 90px 0 60px;
        }

        .hero h1 {
            font-size: clamp(3rem, 7vw, 6rem);
            line-height: .95;
        }

        .form-control,
        .form-select {
            border-radius: 10px;
            padding: 12px 14px;
            border-color: var(--line);
        }

        .form-control:focus {
            border-color: var(--accent);
            box-shadow: 0 0 0 .2rem rgba(184, 107, 53, .12);
        }

        .content-editor {
            min-height: 300px;
        }

        .avatar {
            width: 42px;
            height: 42px;
            border-radius: 50%;
            object-fit: cover;
            background: #ddd;
        }

        .avatar-lg {
            width: 90px;
            height: 90px;
            border-radius: 50%;
            object-fit: cover;
        }

        .sidebar {
            min-height: calc(100vh - 72px);
            background: #171717;
            color: white;
        }

        .sidebar a {
            display: block;
            padding: 12px 15px;
            border-radius: 8px;
            color: #cfcfcf;
            margin-bottom: 4px;
        }

        .sidebar a:hover,
        .sidebar a.active {
            background: #2b2b2b;
            color: white;
        }

        .table-card {
            background: white;
            border: 1px solid var(--line);
            border-radius: 16px;
            overflow: hidden;
        }

        footer {
            border-top: 1px solid var(--line);
            margin-top: 70px;
            padding: 30px 0;
            color: var(--muted);
        }
    </style>
</head>

<body>