<%- include("../partials/header") %>
    <%- include("../partials/navbar") %>

        <div class="container py-5">

            <%- include("../partials/flash") %>

                <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center mb-5">

                    <div>

                        <span class="text-muted text-uppercase small">
                            Your workspace
                        </span>

                        <h1 class="mt-2">
                            Welcome, <%= currentUser.name %>.
                        </h1>

                        <p class="text-muted mb-0">
                            Manage your stories and keep sharing your ideas.
                        </p>

                    </div>

                    <div class="mt-3 mt-md-0">

                        <a href="/blogs/create" class="btn btn-ink">
                            <i class="bi bi-plus-lg me-1"></i>
                            Write a story
                        </a>

                    </div>

                </div>


                <div class="row g-4 mb-5">

                    <div class="col-md-4">

                        <div class="dashboard-card">

                            <i class="bi bi-journal-text fs-3"></i>

                            <p class="text-muted mt-3 mb-1">
                                Your published stories
                            </p>

                            <div class="stat-number">
                                <%= totalBlogs %>
                            </div>

                        </div>

                    </div>


                    <div class="col-md-4">

                        <div class="dashboard-card">

                            <i class="bi bi-person-circle fs-3"></i>

                            <p class="text-muted mt-3 mb-1">
                                Account
                            </p>

                            <div class="fw-semibold">
                                <%= currentUser.email %>
                            </div>

                        </div>

                    </div>


                    <div class="col-md-4">

                        <div class="dashboard-card">

                            <i class="bi bi-shield-check fs-3"></i>

                            <p class="text-muted mt-3 mb-1">
                                Role
                            </p>

                            <div class="fw-semibold">
                                <%= currentUser.role %>
                            </div>

                        </div>

                    </div>

                </div>


                <div class="d-flex justify-content-between align-items-center mb-3">

                    <h3 class="mb-0">
                        Your latest stories
                    </h3>

                    <a href="/blogs">
                        Browse all
                    </a>

                </div>


                <div class="row g-4">

                    <% if (recentBlogs.length===0) { %>

                        <div class="col-12">

                            <div class="dashboard-card text-center py-5">

                                <i class="bi bi-journal-plus fs-1 text-muted"></i>

                                <h3 class="mt-3">
                                    No stories yet
                                </h3>

                                <p class="text-muted">
                                    Your first story is waiting to be written.
                                </p>

                                <a href="/blogs/create" class="btn btn-ink">
                                    Start writing
                                </a>

                            </div>

                        </div>

                        <% } %>


                            <% recentBlogs.forEach(blog=> { %>

                                <div class="col-md-6 col-lg-4">

                                    <div class="blog-card">

                                        <% if (blog.image && blog.image.url) { %>

                                            <img src="<%= blog.image.url %>" class="blog-image" alt="<%= blog.title %>">

                                            <% } else { %>

                                                <div class="placeholder-image">
                                                    <i class="bi bi-image fs-2"></i>
                                                </div>

                                                <% } %>


                                                    <div class="p-4">

                                                        <h4>
                                                            <%= blog.title %>
                                                        </h4>

                                                        <p class="text-muted">
                                                            <%= blog.content.substring(0, 110) %>...
                                                        </p>

                                                        <a href="/blogs/<%= blog._id %>" class="fw-semibold">
                                                            Read story →
                                                        </a>

                                                    </div>

                                    </div>

                                </div>

                                <% }) %>

                </div>

        </div>

        <%- include("../partials/footer") %>